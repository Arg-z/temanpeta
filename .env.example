# Salin file ini menjadi .env lalu sesuaikan isinya.

# Password database PostgreSQL — wajib diganti dengan yang kuat.
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# Alamat yang dilayani Caddy.
# - Uji lokal: SITE_ADDRESS=:80
# - Produksi : SITE_ADDRESS=peta.example.com  (A record domain → IP server;
#   Caddy otomatis menerbitkan sertifikat HTTPS Let's Encrypt saat start)
SITE_ADDRESS=:80

# --- Notifikasi email laporan (opsional; kosong = fitur mati) ---
# Alamat penerima hanya hidup di file ini, tidak pernah tampil di aplikasi.
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=emailmu,
# SMTP_PASS=app-password (myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
REPORT_EMAIL_TO=
